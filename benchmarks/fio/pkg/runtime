runtime | ram: 1G | caps: 500 | binary: fio
+ requires
  + rtc
  + timer

+ config
  + arg | : fio
  + arg | : --rw=randread
  + arg | : --name=IOPS-read
  + arg | : --bs=4k
  + arg | : --direct=1
  + arg | : --size=64M
  + arg | : --filename=/fiofile
  + arg | : --numjobs=1
  + arg | : --iodepth=32
  + vfs
    + dir dev
      + jitterentropy random
      + log
      + null
      + rtc
      + zero
      + dir pipe | + pipe
    + ram
  + libc | stdin:  /dev/null | stdout: /dev/log | stderr: /dev/log
         | rtc:    /dev/rtc  | pipe:   /dev/pipe

+ content
  + rom fio
  + rom ld.lib.so
  + rom libc.lib.so
  + rom libm.lib.so
  + rom posix.lib.so
  + rom vfs.lib.so
  + rom vfs_jitterentropy.lib.so
  + rom vfs_pipe.lib.so
  + rom zlib.lib.so
-
